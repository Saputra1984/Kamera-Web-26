{
  "app_name": "Kamera Web",
  "settings": {
    "default_format": "webp",
    "default_sharpness": "standar",
    "default_color_mode": "natural"
  },
  "sharpness_modes": {
    "low": { "contrast": 0.9, "brightness": 1.0, "filter_css": "contrast(90%)" },
    "standar": { "contrast": 1.0, "brightness": 1.0, "filter_css": "contrast(100%)" },
    "max": { "contrast": 1.25, "brightness": 1.02, "filter_css": "contrast(125%) saturate(115%)" }
  },
  "camera_features": {
    "zoom": { "current": 1, "extreme_digital_multiplier": 4 },
    "exposure": { "current": 0, "min": -3, "max": 3, "step": 0.5 },
    "timer_options": [0, 3, 5, 10],
    "color_filters": {
      "asli": "saturate(1.0) contrast(1.0)",
      "fokus_warna": "saturate(1.7) contrast(1.1)",
      "natural": "saturate(1.1) contrast(0.95)",
      "malam": "saturate(1.2) contrast(1.3) brightness(1.7)",
      "teks": "saturate(0.0) contrast(1.9) brightness(0.95)"
    }
  },
  "menu_titik_tiga": [
    {"id": "fmt_heic", "label": "Format: HEIC (WebP High)", "action": "setFormat", "value": "heic"},
    {"id": "fmt_webp", "label": "Format: WebP", "action": "setFormat", "value": "webp"},
    {"id": "fmt_jpeg", "label": "Format: JPEG", "action": "setFormat", "value": "jpeg"},
    {"id": "fmt_png",  "label": "Format: PNG",  "action": "setFormat", "value": "png"},
    {"id": "fmt_pdf",  "label": "Format: PDF",  "action": "setFormat", "value": "pdf"},
    {"id": "sharp_low", "label": "Ketajaman: Low", "action": "setSharpness", "value": "low"},
    {"id": "sharp_std", "label": "Ketajaman: Standar", "action": "setSharpness", "value": "standar"},
    {"id": "sharp_max", "label": "Ketajaman: Max", "action": "setSharpness", "value": "max"},
    {"id": "mode_malam", "label": "🌙 Mode: Malam", "action": "setColorMode", "value": "malam"},
    {"id": "mode_teks", "label": "🎯 Mode: Fokus Teks", "action": "setColorMode", "value": "teks"},
    {"id": "mode_stabil", "label": "🛡️ Mode: Stabil Kamera", "action": "toggleStability", "value": "true"},
    {"id": "mode_wajah", "label": "🧑‍🦲 Sensor Wajah: On/Off", "action": "toggleFaceSensor", "value": "true"}
  ],
  "navigation_buttons": {
    "right_bottom": [
      { "id": "switch_camera", "action": "switchCamera", "label": "🔄" },
      { "id": "switch_mode", "action": "switchMode", "label": "📸" },
      { "id": "trigger_timer", "action": "cycleTimer", "label": "⏱️" }
                ]
  }
}
